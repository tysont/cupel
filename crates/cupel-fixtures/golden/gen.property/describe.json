          "summary": "Property tests falsified, or failed, under the case budget."
        },
        {
          "name": "missing",
          "per": "scope",
          "summary": "Public functions taking arguments whose tests hold no property test."
        }
      ],
      "needs": [
        "property-results",
        "symbols",
