  "description": {
    "manifest": {
      "cost": "standard",
      "findings": [
        {
          "action": "fix_bug",
          "evidence": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "additionalProperties": false,
            "description": "Evidence of `property.falsified`.",
            "properties": {
              "cases": {
                "description": "The generated cases it was asked to pass.",
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              },
              "counterexample": {
                "description": "The framework's shrunk failing input, as it printed it; null when it failed without one.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "framework": {
                "description": "The framework that generated its inputs, such as `proptest`.",
                "type": "string"
              },
              "runner": {
                "description": "The runner that ran it.",
                "type": "string"
              },
              "seed": {
                "description": "The seed the framework was given; null for a framework that takes none.",
                "format": "uint64",
                "minimum": 0,
                "type": [
                  "integer",
                  "null"
                ]
              },
              "test": {
                "description": "The test's ID, as its runner names it; null when no test the runner reported is the case.",
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "framework",
              "runner",
              "cases"
            ],
            "title": "Falsified",
            "type": "object"
          },
          "kind": "property.falsified",
          "summary": "A property test failed under the run's seed and case budget; the counterexample is the framework's shrunk failing input."
        },
        {
          "action": "add_property",
          "evidence": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "additionalProperties": false,
            "description": "Evidence of `property.missing`.",
            "properties": {
              "frameworks": {
                "description": "The language's property frameworks, in preference order.",
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "function": {
                "description": "The function, as `namespace.name` or the language's spelling of it.",
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "namespace": {
                "type": "string"
              },
              "parameters": {
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              },
              "signature": {
                "description": "Its normalized signature, when the language reports one.",
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "function",
              "name",
              "namespace",
              "parameters",
              "frameworks"
            ],
            "title": "Missing",
            "type": "object"
          },
          "kind": "property.missing",
          "summary": "A public function that takes arguments, in a file whose tests hold no property test."
        }
      ],
      "id": "gen.property",
      "metrics": [
        {
          "name": "properties",
          "per": "scope",
          "summary": "Property tests in scope."
        },
        {
          "name": "falsified",
