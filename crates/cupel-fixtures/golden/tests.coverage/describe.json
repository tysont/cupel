  "description": {
    "manifest": {
      "cost": "standard",
      "findings": [
        {
          "action": "write_test",
          "evidence": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "additionalProperties": false,
            "description": "Evidence of `coverage.uncovered-symbol`.",
            "properties": {
              "covered": {
                "description": "Of those, the ones that ran: none.",
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              },
              "lines": {
                "description": "The symbol's instrumented lines.",
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "lines",
              "covered"
            ],
            "title": "UncoveredSymbol",
            "type": "object"
          },
          "kind": "coverage.uncovered-symbol",
          "summary": "No test ran any instrumented line of the function."
        },
        {
          "action": "write_test",
          "evidence": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "additionalProperties": false,
            "description": "Evidence of `coverage.uncovered-branch`.",
            "properties": {
              "branches": {
                "description": "The branches the coverage map measured in the symbol.",
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              },
              "lines": {
                "description": "The line of each branch no test took, in order, each once.",
                "items": {
                  "format": "uint32",
                  "minimum": 0,
                  "type": "integer"
                },
                "type": "array"
              },
              "uncovered": {
                "description": "Of those, the ones no test took.",
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "branches",
              "uncovered",
              "lines"
            ],
            "title": "UncoveredBranch",
            "type": "object"
          },
          "kind": "coverage.uncovered-branch",
          "summary": "Tests ran the function but never took some of its branches."
        },
        {
          "action": "write_test",
          "evidence": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "additionalProperties": false,
            "description": "Evidence of `coverage.unloaded-file`.",
            "properties": {
              "covered": {
                "description": "Of those, the ones that ran: none.",
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              },
              "lines": {
                "description": "The symbol's lines, which stand in for the instrumented lines the tool never listed.",
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "lines",
              "covered"
            ],
            "title": "UnloadedFile",
            "type": "object"
          },
          "kind": "coverage.unloaded-file",
          "summary": "No test loaded the function's file, so the coverage tool never listed it."
        }
      ],
      "id": "tests.coverage",
      "metrics": [
        {
          "name": "line",
          "per": "scope",
          "summary": "The share of the scored functions' instrumented lines that ran; the score."
        },
        {
          "name": "branch",
          "per": "scope",
          "summary": "The share of the scored functions' branches that were taken; only when measured."
        },
        {
          "name": "lines",
          "per": "scope",
          "summary": "Instrumented lines in the scored functions."
        },
        {
          "name": "branches",
          "per": "scope",
          "summary": "Measured branches in the scored functions."
        },
        {
          "name": "uncovered",
          "per": "scope",
          "summary": "Functions in scope no test ran."
        },
        {
          "name": "uncovered_lines",
          "per": "symbol",
          "summary": "Instrumented lines of the function that never ran."
        },
        {
          "name": "line_coverage",
          "per": "symbol",
          "protection": "coverage",
          "summary": "Instrumented lines of the function that ran, as a ratio of all of them."
        }
      ],
      "needs": [
        "symbols",
        "coverage-map"
      ],
      "stability": "experimental",
      "summary": "Line and branch coverage per function, from the coverage tool the language's `[lang.<id>] coverage` command runs (or a fresh report it left). Branch findings only where the tool measured branches; otherwise the result notes `branches: unavailable`. A function with no instrumented line is not scored, unless the tool lists only the files the suite loaded: then a function in a file it left out never ran.",
      "tier": 2,
      "version": 1,
      "wants": [
        "norm-tree",
        "test-conventions"
      ]
    },
    "subject": "check"
  },
