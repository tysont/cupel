{
  "checks": [],
  "cupel": {
    "schema": "https://tysont.github.io/cupel/schema/v1/run.json",
    "version": "<version>"
  },
  "description": {
    "manifest": {
      "cost": "quick",
      "findings": [
        {
          "action": "reduce_complexity",
          "evidence": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "additionalProperties": false,
            "description": "Evidence of `complexity.high`.",
            "properties": {
              "cognitive": {
                "description": "The cognitive weight of every decision, structural ones increased by their nesting.",
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              },
              "cognitive_max": {
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              },
              "cyclomatic": {
                "description": "Modified cyclomatic complexity: 1 plus the cyclomatic weight of every decision, a match or\nswitch counting once (ADR-072).",
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              },
              "cyclomatic_max": {
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "cyclomatic",
              "cognitive",
              "cyclomatic_max",
              "cognitive_max"
            ],
            "title": "ComplexityHigh",
            "type": "object"
          },
          "hints": {
            "deepest_block": {
              "$defs": {
                "DecisionKind": {
                  "enum": [
                    "branch",
                    "loop",
                    "boolean-op",
                    "case",
                    "catch",
                    "early-return",
                    "ternary"
                  ],
                  "type": "string"
                },
                "Location": {
                  "description": "A span in a file. Paths are relative to the repository root; lines and columns are 1-based.",
                  "properties": {
                    "col": {
                      "format": "uint32",
                      "minimum": 0,
                      "type": [
                        "integer",
                        "null"
                      ]
                    },
                    "end_col": {
                      "format": "uint32",
                      "minimum": 0,
                      "type": [
                        "integer",
                        "null"
                      ]
                    },
                    "end_line": {
                      "format": "uint32",
                      "minimum": 0,
                      "type": "integer"
                    },
                    "file": {
                      "type": "string"
                    },
                    "line": {
                      "format": "uint32",
                      "minimum": 0,
                      "type": "integer"
                    }
                  },
                  "required": [
                    "file",
                    "line",
                    "end_line"
                  ],
                  "type": "object"
                }
              },
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "description": "The function's most deeply nested block: the extraction candidate, on `complexity.high`.",
              "properties": {
                "cognitive": {
                  "description": "What they add to its cognitive complexity, nesting increments included.",
                  "format": "uint32",
                  "minimum": 0,
                  "type": "integer"
                },
                "cyclomatic": {
                  "description": "What the decisions inside the block add to the function's cyclomatic complexity.",
                  "format": "uint32",
                  "minimum": 0,
                  "type": "integer"
                },
                "location": {
                  "$ref": "#/$defs/Location"
                },
                "nesting": {
                  "description": "Enclosing blocks that nest it, 0 at the top of the body.",
                  "format": "uint32",
                  "minimum": 0,
                  "type": "integer"
                },
                "path": {
                  "description": "The construct kinds from the outermost enclosing block to this block.",
                  "items": {
                    "$ref": "#/$defs/DecisionKind"
                  },
                  "type": "array"
                }
              },
              "required": [
                "location",
                "nesting",
                "path",
                "cyclomatic",
                "cognitive"
              ],
              "title": "DeepestBlock",
              "type": "object"
            }
          },
          "kind": "complexity.high",
          "summary": "Cyclomatic or cognitive complexity exceeds its limit (cyclomatic_max, cognitive_max)."
        },
        {
          "action": "reduce_complexity",
          "evidence": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "additionalProperties": false,
            "description": "Evidence of `nesting.deep`.",
            "properties": {
              "depth": {
                "description": "The deepest level of nested branches, loops, cases, handlers, and conditionals.",
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              },
              "nesting_max": {
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "depth",
              "nesting_max"
            ],
            "title": "NestingDeep",
            "type": "object"
          },
          "kind": "nesting.deep",
          "summary": "Control flow nests deeper than nesting_max."
        },
        {
          "action": "refactor_extract",
          "evidence": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "additionalProperties": false,
            "description": "Evidence of `params.many`.",
            "properties": {
              "parameters": {
                "description": "Declared parameters, not counting a receiver.",
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              },
              "params_max": {
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "parameters",
              "params_max"
            ],
            "title": "ParamsMany",
            "type": "object"
          },
          "kind": "params.many",
          "summary": "More declared parameters than params_max, not counting a receiver."
        },
        {
          "action": "refactor_extract",
          "evidence": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "additionalProperties": false,
            "description": "Evidence of `function.long`.",
            "properties": {
              "length_max": {
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              },
              "lines": {
                "description": "Lines the symbol spans, from its first line to its last.",
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "lines",
              "length_max"
            ],
            "title": "FunctionLong",
            "type": "object"
          },
          "kind": "function.long",
          "summary": "The symbol spans more lines than length_max."
        }
      ],
      "id": "static.complexity",
      "metrics": [
        {
          "name": "cyclomatic_max",
          "per": "scope",
          "summary": "The largest modified cyclomatic complexity in scope (a match counts once)."
        },
        {
          "name": "cognitive_max",
          "per": "scope",
          "summary": "The largest cognitive complexity in scope."
        },
        {
          "name": "nesting_max",
          "per": "scope",
          "summary": "The deepest nesting in scope."
        },
        {
          "name": "params_max",
          "per": "scope",
          "summary": "The most parameters any symbol in scope declares."
        },
        {
          "name": "length_max",
          "per": "scope",
          "summary": "The most lines any symbol in scope spans."
        },
        {
          "name": "cyclomatic",
          "per": "symbol",
          "summary": "Modified cyclomatic complexity per function (a match counts once)."
        },
        {
          "name": "cognitive",
          "per": "symbol",
          "summary": "Cognitive complexity per function."
        }
      ],
      "needs": [
        "symbols",
        "decisions",
        "norm-tree"
      ],
      "settings": [
        {
          "default": 10,
          "name": "cyclomatic_max",
          "summary": "The highest cyclomatic complexity a symbol may have; above it is complexity.high."
        },
        {
          "default": 15,
          "name": "cognitive_max",
          "summary": "The highest cognitive complexity a symbol may have; above it is complexity.high."
        },
        {
          "default": 4,
          "name": "nesting_max",
          "summary": "The deepest control-flow nesting a symbol may have; deeper is nesting.deep."
        },
        {
          "default": 5,
          "name": "params_max",
          "summary": "The most parameters a symbol may declare, not counting a receiver; more is params.many."
        },
        {
          "default": 60,
          "name": "length_max",
          "summary": "The most lines a symbol may span; more is function.long."
        }
      ],
      "stability": "experimental",
      "summary": "Cyclomatic and cognitive complexity, nesting depth, parameter count, and length per function, against configurable limits. Cyclomatic complexity is the modified form: a match or switch counts as one decision however many arms it has.",
      "tier": 0,
      "version": 2,
