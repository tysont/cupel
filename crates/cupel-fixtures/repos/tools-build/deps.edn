;; ABOUTME: A tools.deps Clojure project shaped like clj-commons/clj-yaml: Java sources its :deps/prep-lib build compiles,
;; ABOUTME: a pom.xml template the build fills at release, and a :test alias whose :main-opts run its own test runner.
{:paths ["src/clojure" "target/classes"]
 :deps {org.clojure/clojure {:mvn/version "1.12.3"}}
 :deps/prep-lib {:alias :build
                 :fn compile-java
                 :ensure "target/classes"}
 :aliases
 {;; `runner/` stands in for io.github.cognitect-labs/test-runner, so the fixture needs no git dependency.
  :test {:extra-paths ["test" "runner"]
         :main-opts ["-m" "cognitect.test-runner"]}
  ;; clj-yaml's build uses tools.build; this one compiles with the JDK alone, so it needs no dependency.
  :build {:extra-paths ["build"]
          :ns-default build}}}
