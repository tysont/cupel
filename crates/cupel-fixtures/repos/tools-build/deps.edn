;; ABOUTME: A tools.deps Clojure project shaped like clj-commons/clj-yaml: Java sources tools.build compiles, a pom.xml
;; ABOUTME: template the build fills at release, and a :test alias whose :main-opts run its own test runner.
{:paths ["src/clojure" "target/classes"]
 :deps {org.clojure/clojure {:mvn/version "1.12.3"}}
 :deps/prep-lib {:alias :build
                 :fn compile-java
                 :ensure "target/classes"}
 :aliases
 {;; `runner/` stands in for io.github.cognitect-labs/test-runner, so the fixture needs no git dependency.
  :test {:extra-paths ["test" "runner"]
         :main-opts ["-m" "cognitect.test-runner"]}
  :build {:extra-paths ["build"]
          :deps {io.github.clojure/tools.build {:mvn/version "0.10.14"}}
          :ns-default build}}}
