<?xml version="1.0" encoding="UTF-8"?>
<!-- ABOUTME: A module that runs JaCoCo's agent itself, as FasterXML/jackson-core does: it declares the plugin, its parent
     ABOUTME: binds prepare-agent, and Surefire passes @{argLine}; a second agent by coordinate kills the forked JVM. -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>example</groupId>
    <artifactId>grade-base</artifactId>
    <version>1.0</version>
    <relativePath>parent/pom.xml</relativePath>
  </parent>
  <artifactId>grade</artifactId>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.13.4</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.3</version>
        <configuration>
          <argLine>@{argLine} -Xmx256m</argLine>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
