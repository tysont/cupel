---
source: crates/cupel-core/tests/schemas.rs
expression: pretty(&schema)
---
{
  "$id": "https://tysont.github.io/cupel/schema/v1/events.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Event",
  "description": "A progress event. Findings stream as they are discovered.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "checks": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "est_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "ev": {
          "type": "string",
          "const": "plan"
        },
        "run": {
          "$ref": "#/$defs/RunId"
        }
      },
      "required": [
        "checks",
        "est_ms",
        "ev",
        "run"
      ]
    },
    {
      "type": "object",
      "properties": {
        "ev": {
          "type": "string",
          "const": "check.start"
        },
        "id": {
          "$ref": "#/$defs/CheckId"
        },
        "targets": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "ev",
        "id",
        "targets"
      ]
    },
    {
      "type": "object",
      "properties": {
        "ev": {
          "type": "string",
          "const": "finding"
        }
      },
      "$ref": "#/$defs/Finding",
      "required": [
        "ev"
      ]
    },
    {
      "type": "object",
      "properties": {
        "done": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "eta_ms": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "ev": {
          "type": "string",
          "const": "progress"
        },
        "id": {
          "$ref": "#/$defs/CheckId"
        },
        "total": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "done",
        "eta_ms",
        "ev",
        "id",
        "total"
      ]
    },
    {
      "type": "object",
      "properties": {
        "duration_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "ev": {
          "type": "string",
          "const": "check.end"
        },
        "id": {
          "$ref": "#/$defs/CheckId"
        },
        "status": {
          "$ref": "#/$defs/CheckStatus"
        }
      },
      "required": [
        "duration_ms",
        "ev",
        "id",
        "status"
      ]
    },
    {
      "type": "object",
      "properties": {
        "ev": {
          "type": "string",
          "const": "skip"
        },
        "id": {
          "$ref": "#/$defs/CheckId"
        },
        "reason": {
          "$ref": "#/$defs/SkipReason"
        }
      },
      "required": [
        "ev",
        "id",
        "reason"
      ]
    },
    {
      "type": "object",
      "properties": {
        "ev": {
          "type": "string",
          "const": "run.end"
        },
        "exit_code": {
          "$ref": "#/$defs/ExitCode"
        },
        "status": {
          "$ref": "#/$defs/Status"
        }
      },
      "required": [
        "ev",
        "exit_code",
        "status"
      ]
    }
  ],
  "$defs": {
    "Action": {
      "description": "The concrete next step a finding asks for.",
      "type": "object",
      "properties": {
        "hints": {
          "description": "Kind-specific pointers, such as `nearest_test_file` or `covering_tests`.",
          "type": "object",
          "additionalProperties": true
        },
        "kind": {
          "$ref": "#/$defs/ActionKind"
        },
        "priority": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "summary": {
          "type": "string"
        }
      },
      "required": [
        "hints",
        "kind",
        "priority",
        "summary"
      ]
    },
    "ActionKind": {
      "description": "The closed set of things a finding can ask an agent to do (design §7.2).",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "write_test",
            "strengthen_assertion",
            "restore_test",
            "refactor_extract",
            "reduce_complexity",
            "break_cycle",
            "fix_bug",
            "add_contract",
            "add_property",
            "investigate_flake",
            "rerun",
            "configure",
            "install_tool",
            "verify_oracle"
          ]
        },
        {
          "description": "Last resort when no mechanical action exists.",
          "type": "string",
          "const": "review"
        }
      ]
    },
    "CheckId": {
      "description": "A check's stable namespaced ID, such as `tests.mutation`.",
      "type": "string"
    },
    "CheckStatus": {
      "description": "A check's outcome (ADR-013).",
      "type": "string",
      "enum": [
        "pass",
        "fail",
        "partial",
        "error",
        "skipped"
      ]
    },
    "Evidence": {
      "description": "Check-specific supporting data. Its shape per finding kind is the JSON Schema the emitting\ncheck declares in its manifest (ADR-012).",
      "type": "object",
      "additionalProperties": true
    },
    "ExitCode": {
      "description": "0 pass · 1 fail · 2 usage · 3 environment · 4 unevaluable · 5 partial · 6 internal",
      "type": "integer",
      "enum": [
        0,
        1,
        2,
        3,
        4,
        5,
        6
      ]
    },
    "Finding": {
      "description": "One actionable observation produced by a check.",
      "type": "object",
      "properties": {
        "action": {
          "$ref": "#/$defs/Action"
        },
        "check": {
          "$ref": "#/$defs/CheckId"
        },
        "confidence": {
          "description": "How sure the check is, from 0 to 1.",
          "type": "number",
          "format": "double",
          "maximum": 1.0,
          "minimum": 0.0
        },
        "detail": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence": {
          "$ref": "#/$defs/Evidence"
        },
        "id": {
          "$ref": "#/$defs/FindingId"
        },
        "kind": {
          "description": "Namespaced finding kind, such as `mutant.survived`.",
          "type": "string"
        },
        "location": {
          "anyOf": [
            {
              "$ref": "#/$defs/Location"
            },
            {
              "type": "null"
            }
          ]
        },
        "new_since_baseline": {
          "type": "boolean"
        },
        "repro": {
          "description": "A command that reproduces this finding.",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "suppress": {
          "description": "A command that suppresses this finding.",
          "type": "string"
        },
        "suppressed": {
          "type": "boolean"
        },
        "symbol": {
          "anyOf": [
            {
              "$ref": "#/$defs/Symbol"
            },
            {
              "type": "null"
            }
          ]
        },
        "tier": {
          "$ref": "#/$defs/Tier"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "action",
        "check",
        "confidence",
        "detail",
        "evidence",
        "id",
        "kind",
        "location",
        "new_since_baseline",
        "repro",
        "severity",
        "suppress",
        "suppressed",
        "symbol",
        "tier",
        "title"
      ]
    },
    "FindingId": {
      "description": "`fnd_` followed by six lowercase hex digits",
      "type": "string",
      "pattern": "^fnd_[0-9a-f]{6}$"
    },
    "LangId": {
      "description": "A language's ID, such as `rust` or `typescript`. Languages are registered by\n`cupel-lang`; core never enumerates them (ADR-011).",
      "type": "string"
    },
    "Location": {
      "description": "A span in a file. Paths are relative to the repository root; lines and columns are 1-based.",
      "type": "object",
      "properties": {
        "col": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "end_col": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "end_line": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "file": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "col",
        "end_col",
        "end_line",
        "file",
        "line"
      ]
    },
    "RunId": {
      "description": "A run ID: `run_` followed by a ULID.",
      "type": "string",
      "pattern": "^run_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "Severity": {
      "type": "string",
      "enum": [
        "fail",
        "warn",
        "info"
      ]
    },
    "SkipReason": {
      "type": "string",
      "enum": [
        "unsupported",
        "unavailable",
        "unconfigured",
        "budget",
        "timeout",
        "needs-range"
      ]
    },
    "Status": {
      "description": "Overall outcome. `partial` and `error` are distinct from `fail`.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "partial",
            "error"
          ]
        },
        {
          "description": "A `--dry-run` plan; nothing ran.",
          "type": "string",
          "const": "plan"
        }
      ]
    },
    "Symbol": {
      "description": "The function or method a finding is about.",
      "type": "object",
      "properties": {
        "display": {
          "description": "`namespace::name`, for people.",
          "type": "string"
        },
        "hash": {
          "description": "Structural identity, for machines.",
          "$ref": "#/$defs/SymbolHash"
        },
        "lang": {
          "$ref": "#/$defs/LangId"
        }
      },
      "required": [
        "display",
        "hash",
        "lang"
      ]
    },
    "SymbolHash": {
      "description": "`sh_` followed by sixteen lowercase hex digits",
      "type": "string",
      "pattern": "^sh_[0-9a-f]{16}$"
    },
    "Tier": {
      "description": "Evidence tier: 0 structural metric … 6 proof.",
      "type": "integer",
      "maximum": 6,
      "minimum": 0
    }
  }
}
