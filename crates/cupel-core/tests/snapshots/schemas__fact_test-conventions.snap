---
source: crates/cupel-core/tests/schemas.rs
expression: pretty(&schema)
---
{
  "$id": "https://tysont.github.io/cupel/schema/v1/fact/test-conventions.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TestConventions",
  "description": "How test files are recognized and which tests belong to which source file.",
  "type": "object",
  "properties": {
    "pairs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/TestPairing"
      }
    },
    "test_globs": {
      "description": "Globs that match test files; a file is a test exactly when one matches.",
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "pairs",
    "test_globs"
  ],
  "x-cupel-fact-version": 1,
  "$defs": {
    "TestPairing": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string"
        },
        "tests": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "source",
        "tests"
      ]
    }
  }
}
