---
source: crates/cupel-core/tests/schemas.rs
expression: pretty(&schema)
---
{
  "$id": "https://cupel.dev/schema/v1/fact/test-reruns.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TestReruns",
  "description": "The baseline's tests, rerun (ADR-078).",
  "type": "object",
  "properties": {
    "runner": {
      "description": "The runner whose baseline was rerun, such as `tool.pytest`.",
      "$ref": "#/$defs/ProducerId"
    },
    "runs": {
      "description": "Every rerun, in the order they ran.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/TestRerun"
      }
    },
    "seed": {
      "description": "The run's seed; every rerun's seed derives from it, so the same seed repeats the reruns.",
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    }
  },
  "required": [
    "runner",
    "runs",
    "seed"
  ],
  "x-cupel-fact-version": 1,
  "$defs": {
    "ProducerId": {
      "description": "A producer's ID, such as `lang.go`, `tool.pytest-cov`, or `engine.mutation`.",
      "type": "string"
    },
    "RunOrder": {
      "description": "The order a rerun asked the runner for.",
      "oneOf": [
        {
          "description": "The runner's own order: as declared, or sorted by name.",
          "type": "string",
          "const": "declared"
        },
        {
          "description": "The declared order backwards, for runners that take an explicit order.",
          "type": "string",
          "const": "reversed"
        },
        {
          "description": "The runner's seeded shuffle, with this rerun's seed.",
          "type": "string",
          "const": "shuffled"
        }
      ]
    },
    "RunnerInvocation": {
      "description": "One run of a runner in one project root.",
      "type": "object",
      "properties": {
        "command": {
          "description": "The program and its arguments, as run.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "completed": {
          "description": "Whether the runner reached the end of the suite and reported it: false for a build that\nfailed, a crash, or a report that could not be read.",
          "type": "boolean"
        },
        "dir": {
          "description": "The directory it ran in, relative to the repository root, `/`-separated; `.` for the root.",
          "type": "string"
        },
        "exit_code": {
          "description": "`None` when the process was ended by a signal.",
          "type": [
            "integer",
            "null"
          ],
          "format": "int32"
        },
        "output": {
          "description": "The tail of the runner's output, when it did not complete.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "command",
        "completed",
        "dir",
        "exit_code",
        "output"
      ]
    },
    "TestOutcome": {
      "description": "How a test ended.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "passed"
          ]
        },
        {
          "description": "An assertion or panic in the test.",
          "type": "string",
          "const": "failed"
        },
        {
          "description": "Ignored, pending, todo, or skipped.",
          "type": "string",
          "const": "skipped"
        },
        {
          "description": "The test or its suite could not run, such as a file that does not load or build.",
          "type": "string",
          "const": "errored"
        }
      ]
    },
    "TestRerun": {
      "description": "One rerun of the suite: what it varied and what every test did.",
      "type": "object",
      "properties": {
        "executed": {
          "description": "Test IDs in the order they ran, when the runner reports it.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "invocations": {
          "description": "One per project root, as in `TestResults`.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/RunnerInvocation"
          }
        },
        "order": {
          "$ref": "#/$defs/RunOrder"
        },
        "parallelism": {
          "description": "The worker or thread count asked for; `None` for the runner's default.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "seed": {
          "description": "The seed this rerun handed the runner: its shuffle seed, its hash seed.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "tests": {
          "description": "Every test the runner reported, sorted by ID, with the baseline's IDs.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/TestResult"
          }
        }
      },
      "required": [
        "executed",
        "invocations",
        "order",
        "parallelism",
        "seed",
        "tests"
      ]
    },
    "TestResult": {
      "description": "One test as its runner reported it.",
      "type": "object",
      "properties": {
        "duration_ms": {
          "description": "`None` when the runner does not measure it.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "file": {
          "description": "The file the runner attributes the test to, relative to the repository root.",
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "description": "The runner's identity of the test, unique within the fact and stable across runs.",
          "type": "string"
        },
        "name": {
          "description": "The runner's display name of the test.",
          "type": "string"
        },
        "outcome": {
          "$ref": "#/$defs/TestOutcome"
        },
        "output": {
          "description": "For `failed` and `errored` tests, the tail of the failure message and captured output.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "duration_ms",
        "file",
        "id",
        "name",
        "outcome",
        "output"
      ]
    }
  }
}
