---
source: crates/cupel-core/tests/schemas.rs
expression: pretty(&schema)
---
{
  "$id": "https://tysont.github.io/cupel/schema/v1/fact/mutation-outcomes.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MutationOutcomes",
  "description": "What mutation testing found in scope (ADR-080; version 2 adds how each mutant was built,\nADR-082).",
  "type": "object",
  "properties": {
    "depth": {
      "description": "The depth the engine planned for.",
      "$ref": "#/$defs/CostClass"
    },
    "engine": {
      "description": "The producer, such as `engine.mutation`.",
      "$ref": "#/$defs/ProducerId"
    },
    "excluded": {
      "description": "The tests slower than 60 s (`SLOW_TEST_MS`) in the baseline that were left out of the\nmutants' whole-suite runs (ADR-147), sorted by ID; absent when none was.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/ExcludedTest"
      },
      "x-cupel-optional": true
    },
    "mutants": {
      "description": "One per (site, replacement), sorted by file, position, then replacement.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Mutant"
      }
    },
    "per_test": {
      "description": "Whether the tests run against each mutant were selected by a `PerTestMap`.",
      "type": "boolean"
    },
    "phases": {
      "description": "The phases the production went through, in the order they ended: its timeline, from\nwhich each phase's total is read (ADR-150). Absent when no mutant ran.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/PhaseDuration"
      },
      "x-cupel-optional": true
    },
    "runner": {
      "description": "The runner that ran the mutants; `None` when none ran.",
      "anyOf": [
        {
          "$ref": "#/$defs/ProducerId"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "depth",
    "engine",
    "mutants",
    "per_test",
    "runner"
  ],
  "x-cupel-fact-version": 2,
  "$defs": {
    "CostClass": {
      "description": "How expensive a check or producer is to run. The same names select a run's depth (design §5.8).",
      "type": "string",
      "enum": [
        "quick",
        "standard",
        "deep",
        "exhaustive"
      ]
    },
    "ExcludedTest": {
      "description": "A test left out of the mutants' whole-suite runs for its baseline duration (ADR-147).",
      "type": "object",
      "properties": {
        "baseline_ms": {
          "description": "Its duration in the baseline run.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "file": {
          "description": "The file the runner attributes it to, relative to the repository root.",
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "description": "The runner's ID of the test.",
          "type": "string"
        }
      },
      "required": [
        "baseline_ms",
        "file",
        "id"
      ]
    },
    "Mutant": {
      "description": "One mutant: a site with one replacement, and what became of it.",
      "type": "object",
      "properties": {
        "cache_key": {
          "description": "The key its outcome is stored and reused under (ADR-080 §10); `None` from a producer\nthat does not reuse outcomes.",
          "type": [
            "string",
            "null"
          ]
        },
        "duration_ms": {
          "description": "The wall time of the mutant's run; `None` when it was not run.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "equivalent": {
          "description": "Why the mutant may be equivalent to the original (ADR-004); `None` when nothing says so.",
          "type": [
            "string",
            "null"
          ]
        },
        "fallback": {
          "description": "Why a mutant of a language with schemata was built as a file copy instead; `None`\notherwise.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "from": {
          "description": "The source text replaced.",
          "type": "string"
        },
        "killing_tests": {
          "description": "Of `tests`, those that failed or errored.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "operator": {
          "$ref": "#/$defs/MutationOperator"
        },
        "outcome": {
          "$ref": "#/$defs/MutantOutcome"
        },
        "reused": {
          "description": "Whether the outcome was reused from an earlier run (ADR-080 §10).",
          "type": "boolean"
        },
        "site_hash": {
          "$ref": "#/$defs/SiteHash"
        },
        "span": {
          "description": "Where `from` is, in the symbol's file.",
          "$ref": "#/$defs/Span"
        },
        "strategy": {
          "description": "How the mutant was built (ADR-082); `None` when it was not run, or its outcome was\nstored before strategies were recorded.",
          "anyOf": [
            {
              "$ref": "#/$defs/MutationStrategy"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "symbol": {
          "description": "The symbol the site belongs to.",
          "$ref": "#/$defs/SymbolKey"
        },
        "symbol_hash": {
          "description": "The symbol's structural hash (ADR-025), when the engine had one.",
          "anyOf": [
            {
              "$ref": "#/$defs/SymbolHash"
            },
            {
              "type": "null"
            }
          ]
        },
        "tests": {
          "description": "The tests run against the mutant, by their runner's IDs; empty when it was not run.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "to": {
          "description": "What replaced it.",
          "type": "string"
        }
      },
      "required": [
        "cache_key",
        "duration_ms",
        "equivalent",
        "fallback",
        "from",
        "killing_tests",
        "operator",
        "outcome",
        "reused",
        "site_hash",
        "span",
        "strategy",
        "symbol",
        "symbol_hash",
        "tests",
        "to"
      ]
    },
    "MutantOutcome": {
      "description": "What became of a mutant.",
      "oneOf": [
        {
          "description": "A test failed against it.",
          "type": "string",
          "const": "killed"
        },
        {
          "description": "Every test run against it passed.",
          "type": "string",
          "const": "survived"
        },
        {
          "description": "Its run took longer than its timeout.",
          "type": "string",
          "const": "timeout"
        },
        {
          "description": "Its run held more memory than its budget and was killed (ADR-148).",
          "type": "string",
          "const": "out-of-memory"
        },
        {
          "description": "No test runs its site, so it was not run (coverage gating).",
          "type": "string",
          "const": "uncovered"
        },
        {
          "description": "Its run did not complete and no test failed: it did not build or load.",
          "type": "string",
          "const": "unviable"
        }
      ]
    },
    "MutationOperator": {
      "type": "string",
      "enum": [
        "relational",
        "equality",
        "arith-add-sub",
        "arith-mul-div",
        "boolean-op",
        "boolean-literal",
        "zero-one",
        "statement-deletion",
        "return-value",
        "constant",
        "boundary",
        "negation"
      ]
    },
    "MutationPhase": {
      "description": "A phase of a mutation production (ADR-150).",
      "oneOf": [
        {
          "description": "Planning the mutants in focus: coverage gating, per-test selection, and the store's\nhistory; once per production.",
          "type": "string",
          "const": "plan"
        },
        {
          "description": "One slot's reconciliation with the tree (ADR-080 §8); once per slot used.",
          "type": "string",
          "const": "sync"
        },
        {
          "description": "One file's schemata rewrite (ADR-082 §2); once per attempt.",
          "type": "string",
          "const": "rewrite"
        },
        {
          "description": "The run every mutant of a file shares: the schemata validation (ADR-082 §5) or a file\ncopy's reference run (ADR-080 §9), its build and the file's selected tests with no\nmutant; once per slot the file used.",
          "type": "string",
          "const": "build"
        },
        {
          "description": "One mutant's test run, as long as the mutant's `duration_ms`.",
          "type": "string",
          "const": "run"
        },
        {
          "description": "A slot with no build of its own given a copy of another slot's (ADR-150 §6); once per\nslot seeded.",
          "type": "string",
          "const": "seed"
        }
      ]
    },
    "MutationStrategy": {
      "description": "How a mutant was built (ADR-082).",
      "oneOf": [
        {
          "description": "One build of the file with every mutant behind a run-time switch, selected by\n`CUPEL_MUTANT`.",
          "type": "string",
          "const": "schemata"
        },
        {
          "description": "The file rewritten with only this mutant, and rebuilt.",
          "type": "string",
          "const": "file-copy"
        }
      ]
    },
    "PhaseDuration": {
      "description": "One phase of a mutation production and how long it took (ADR-150).",
      "type": "object",
      "properties": {
        "duration_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "file": {
          "description": "The file whose mutants the phase served, relative to the repository root; `None` for a\nphase of the whole production (`plan`, `sync`).",
          "type": [
            "string",
            "null"
          ]
        },
        "phase": {
          "$ref": "#/$defs/MutationPhase"
        },
        "slot": {
          "description": "The slot the phase ran in; `None` for a phase that runs in none (`plan`, `rewrite`).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "tests": {
          "description": "How many tests the phase ran, when it ran tests selected for the file's mutants; `None`\nfor a phase that runs no tests, or that ran the whole suite.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "duration_ms",
        "file",
        "phase",
        "slot",
        "tests"
      ]
    },
    "ProducerId": {
      "description": "A producer's ID, such as `lang.go`, `tool.pytest-cov`, or `engine.mutation`.",
      "type": "string"
    },
    "SiteHash": {
      "description": "sixteen lowercase hex digits",
      "type": "string",
      "pattern": "^[0-9a-f]{16}$"
    },
    "Span": {
      "description": "A 1-based range within one file.",
      "type": "object",
      "properties": {
        "col": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "end_col": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "end_line": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "line": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "col",
        "end_col",
        "end_line",
        "line"
      ]
    },
    "SymbolHash": {
      "description": "`sh_` followed by sixteen lowercase hex digits",
      "type": "string",
      "pattern": "^sh_[0-9a-f]{16}$"
    },
    "SymbolKey": {
      "description": "Identifies a symbol within one run by where it starts. Not stable across edits; anything\npersisted across runs uses `SymbolHash` (ADR-014).",
      "type": "object",
      "properties": {
        "col": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "file": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "col",
        "file",
        "line"
      ]
    }
  }
}
