---
source: crates/cupel-core/tests/schemas.rs
expression: pretty(&schema)
---
{
  "$id": "https://tysont.github.io/cupel/schema/v1/fact/fuzz-results.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FuzzResults",
  "description": "The fuzz targets of a language's projects, each fuzzed once with an execution budget\n(ADR-107).",
  "type": "object",
  "properties": {
    "cases": {
      "description": "The executions each target was given.",
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "roots": {
      "description": "Every project root searched for targets, relative to the repository root.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "seed": {
      "description": "The run's seed, handed to the fuzzer when it takes one.",
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "seeded": {
      "description": "Whether the fuzzer took the seed (Go's does not).",
      "type": "boolean"
    },
    "targets": {
      "description": "Every target found there, by root, then name.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/FuzzTarget"
      }
    },
    "tool": {
      "description": "The fuzzer, such as `tool.cargo-fuzz` or `tool.go-fuzz`.",
      "$ref": "#/$defs/ProducerId"
    }
  },
  "required": [
    "cases",
    "roots",
    "seed",
    "seeded",
    "targets",
    "tool"
  ],
  "x-cupel-fact-version": 1,
  "$defs": {
    "FuzzCrash": {
      "description": "An input that crashed or hung a target, and how to run it again.",
      "type": "object",
      "properties": {
        "input": {
          "description": "The input, as text when it is printable UTF-8, else `hex:` and its bytes; at most 256\ncharacters of it.",
          "type": "string"
        },
        "location": {
          "description": "Where it failed in the repository, when the failure names a place there.",
          "anyOf": [
            {
              "$ref": "#/$defs/Location"
            },
            {
              "type": "null"
            }
          ]
        },
        "message": {
          "description": "What the target reported, with addresses and thread numbers masked.",
          "type": "string"
        },
        "reproduce": {
          "description": "The command that runs the target on it, from the project root.",
          "type": [
            "string",
            "null"
          ]
        },
        "reproducer": {
          "description": "The file holding the whole input, relative to the repository root.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "input",
        "location",
        "message",
        "reproduce",
        "reproducer"
      ]
    },
    "FuzzStatus": {
      "description": "How a fuzz target's run ended.",
      "oneOf": [
        {
          "description": "It ran its budget without failing.",
          "type": "string",
          "const": "passed"
        },
        {
          "description": "An input crashed it: a panic, an uncaught exception, a sanitizer error, running out of\nmemory.",
          "type": "string",
          "const": "crashed"
        },
        {
          "description": "An input ran past the fuzzer's per-input time limit.",
          "type": "string",
          "const": "timed-out"
        },
        {
          "description": "The target could not be fuzzed: it did not build, or the fuzzer stopped without saying why.",
          "type": "string",
          "const": "failed"
        }
      ]
    },
    "FuzzTarget": {
      "description": "One fuzz target and how its run ended.",
      "type": "object",
      "properties": {
        "coverage": {
          "description": "The coverage the fuzzer reached, in its own unit (libFuzzer's `cov`), when it reports it.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "crash": {
          "description": "The input that crashed or hung the target.",
          "anyOf": [
            {
              "$ref": "#/$defs/FuzzCrash"
            },
            {
              "type": "null"
            }
          ]
        },
        "detail": {
          "description": "Why a failed run failed: the tail of its output.",
          "type": [
            "string",
            "null"
          ]
        },
        "executions": {
          "description": "Inputs the target ran on, when the fuzzer reports it.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "location": {
          "description": "Where the target is defined, when known.",
          "anyOf": [
            {
              "$ref": "#/$defs/Location"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "description": "The target as the fuzzer names it: a cargo-fuzz binary, a Go `FuzzXxx` function with its\npackage, a fuzz module.",
          "type": "string"
        },
        "root": {
          "description": "The project root it belongs to, as in `roots`.",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/FuzzStatus"
        }
      },
      "required": [
        "coverage",
        "crash",
        "detail",
        "executions",
        "location",
        "name",
        "root",
        "status"
      ]
    },
    "Location": {
      "description": "A span in a file. Paths are relative to the repository root; lines and columns are 1-based.",
      "type": "object",
      "properties": {
        "col": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "end_col": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "end_line": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "file": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "col",
        "end_col",
        "end_line",
        "file",
        "line"
      ]
    },
    "ProducerId": {
      "description": "A producer's ID, such as `lang.go`, `tool.pytest-cov`, or `engine.mutation`.",
      "type": "string"
    }
  }
}
