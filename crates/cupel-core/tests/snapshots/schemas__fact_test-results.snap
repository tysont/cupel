---
source: crates/cupel-core/tests/schemas.rs
expression: pretty(&schema)
---
{
  "$id": "https://tysont.github.io/cupel/schema/v1/fact/test-results.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TestResults",
  "description": "What one run of a test suite reported, normalized across runners (ADR-075).",
  "type": "object",
  "properties": {
    "invocations": {
      "description": "One per project root the runner ran in, in root order.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/RunnerInvocation"
      }
    },
    "reuse": {
      "description": "How a joint suite run obtained these results from its cache (ADR-149 §5); null for a\nrunner that runs its whole suite every time.",
      "anyOf": [
        {
          "$ref": "#/$defs/SuiteReuse"
        },
        {
          "type": "null"
        }
      ]
    },
    "runner": {
      "description": "The producer that ran the suite, such as `tool.pytest`.",
      "$ref": "#/$defs/ProducerId"
    },
    "suite_hash": {
      "description": "Identifies the suite that ran: a blake3 hex digest of the sorted test IDs and the content\nof every file they name.",
      "type": "string"
    },
    "tests": {
      "description": "Every test the runner reported, sorted by ID.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/TestResult"
      }
    }
  },
  "required": [
    "invocations",
    "reuse",
    "runner",
    "suite_hash",
    "tests"
  ],
  "x-cupel-fact-version": 2,
  "$defs": {
    "ProducerId": {
      "description": "A producer's ID, such as `lang.go`, `tool.pytest-cov`, or `engine.mutation`.",
      "type": "string"
    },
    "RunnerInvocation": {
      "description": "One run of a runner in one project root.",
      "type": "object",
      "properties": {
        "command": {
          "description": "The program and its arguments, as run.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "completed": {
          "description": "Whether the runner reached the end of the suite and reported it: false for a build that\nfailed, a crash, or a report that could not be read.",
          "type": "boolean"
        },
        "dir": {
          "description": "The directory it ran in, relative to the repository root, `/`-separated; `.` for the root.",
          "type": "string"
        },
        "exit_code": {
          "description": "`None` when the process was ended by a signal.",
          "type": [
            "integer",
            "null"
          ],
          "format": "int32"
        },
        "output": {
          "description": "The tail of the runner's output, when it did not complete.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "command",
        "completed",
        "dir",
        "exit_code",
        "output"
      ]
    },
    "SuiteMode": {
      "description": "What a joint suite run did.",
      "oneOf": [
        {
          "description": "Every test ran.",
          "type": "string",
          "const": "full"
        },
        {
          "description": "The stale and new tests ran; the rest were kept from the cache (a range scope).",
          "type": "string",
          "const": "incremental"
        },
        {
          "description": "Nothing ran: the tree is as the cache recorded it.",
          "type": "string",
          "const": "cached"
        }
      ]
    },
    "SuitePhase": {
      "description": "A phase of a joint suite run (ADR-155 §1).",
      "oneOf": [
        {
          "description": "The instrumented compile of the suite, before any test runs.",
          "type": "string",
          "const": "build"
        },
        {
          "description": "The run of the tests not kept from the cache, with the tools' own check that the build\nis current and their listing of the tests.",
          "type": "string",
          "const": "test"
        },
        {
          "description": "Every test process's profiles merged and exported alone (ADR-083 §1).",
          "type": "string",
          "const": "export"
        },
        {
          "description": "The whole run's coverage report (ADR-084 §4).",
          "type": "string",
          "const": "report"
        }
      ]
    },
    "SuitePhaseDuration": {
      "description": "One phase of a joint suite run in one project root and how long it took (ADR-155 §1).",
      "type": "object",
      "properties": {
        "dir": {
          "description": "The project root it ran in, relative to the repository root, `/`-separated; `.` for the\nroot.",
          "type": "string"
        },
        "duration_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "phase": {
          "$ref": "#/$defs/SuitePhase"
        }
      },
      "required": [
        "dir",
        "duration_ms",
        "phase"
      ]
    },
    "SuiteReuse": {
      "description": "How many of a joint suite run's tests ran and how many were kept from its cache (ADR-149).",
      "type": "object",
      "properties": {
        "joint": {
          "description": "The joint that ran the suite, such as `tool.llvm-cov-nextest`; absent in a fact written\nbefore it was recorded.",
          "anyOf": [
            {
              "$ref": "#/$defs/ProducerId"
            },
            {
              "type": "null"
            }
          ],
          "x-cupel-optional": true
        },
        "mode": {
          "$ref": "#/$defs/SuiteMode"
        },
        "phases": {
          "description": "The phases the run went through, one per phase per project root, in the order they\nended (ADR-155 §1); absent when nothing ran or the joint times nothing.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/SuitePhaseDuration"
          },
          "x-cupel-optional": true
        },
        "rerun": {
          "description": "The tests that ran under instrumentation in this production.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "reused": {
          "description": "The tests whose results and coverage came from the cache without running.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "tagged": {
          "description": "Of `reused`, the tests their attribution kept though they executed a changed function\n(ADR-151 §4); 0 in a fact written before attributions.",
          "type": "integer",
          "format": "uint64",
          "default": 0,
          "minimum": 0
        }
      },
      "required": [
        "mode",
        "rerun",
        "reused",
        "tagged"
      ]
    },
    "TestOutcome": {
      "description": "How a test ended.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "passed"
          ]
        },
        {
          "description": "An assertion or panic in the test.",
          "type": "string",
          "const": "failed"
        },
        {
          "description": "Ignored, pending, todo, or skipped.",
          "type": "string",
          "const": "skipped"
        },
        {
          "description": "The test or its suite could not run, such as a file that does not load or build.",
          "type": "string",
          "const": "errored"
        }
      ]
    },
    "TestResult": {
      "description": "One test as its runner reported it.",
      "type": "object",
      "properties": {
        "duration_ms": {
          "description": "`None` when the runner does not measure it.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "file": {
          "description": "The file the runner attributes the test to, relative to the repository root.",
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "description": "The runner's identity of the test, unique within the fact and stable across runs.",
          "type": "string"
        },
        "name": {
          "description": "The runner's display name of the test.",
          "type": "string"
        },
        "outcome": {
          "$ref": "#/$defs/TestOutcome"
        },
        "output": {
          "description": "For `failed` and `errored` tests, the tail of the failure message and captured output.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "duration_ms",
        "file",
        "id",
        "name",
        "outcome",
        "output"
      ]
    }
  }
}
