---
source: crates/cupel-core/tests/schemas.rs
expression: pretty(&schema)
---
{
  "$id": "https://cupel.dev/schema/v1/fact/simulation-results.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SimulationResults",
  "description": "The simulation harnesses of a language's projects, each run over the same range of seeds\n(ADR-120).",
  "type": "object",
  "properties": {
    "harnesses": {
      "description": "Every harness found there, by root, then name.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/SimulationHarness"
      }
    },
    "runs": {
      "description": "Each project root the simulator ran in.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/RootRun"
      }
    },
    "seed": {
      "description": "The first seed of the range, the run's seed.",
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "seeds": {
      "description": "How many seeds each harness was given: `seed` up to `seed + seeds - 1`. A harness stops at\nits first failing seed.",
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "tool": {
      "description": "The simulator, such as `tool.madsim`.",
      "$ref": "#/$defs/ProducerId"
    }
  },
  "required": [
    "harnesses",
    "runs",
    "seed",
    "seeds",
    "tool"
  ],
  "x-cupel-fact-version": 1,
  "$defs": {
    "Location": {
      "description": "A span in a file. Paths are relative to the repository root; lines and columns are 1-based.",
      "type": "object",
      "properties": {
        "col": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "end_col": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "end_line": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "file": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "col",
        "end_col",
        "end_line",
        "file",
        "line"
      ]
    },
    "ProducerId": {
      "description": "A producer's ID, such as `lang.go`, `tool.pytest-cov`, or `engine.mutation`.",
      "type": "string"
    },
    "RootRun": {
      "description": "A project root a tool ran in, and how its run ended.",
      "type": "object",
      "properties": {
        "detail": {
          "description": "Why a failed run failed: the tail of its output.",
          "type": [
            "string",
            "null"
          ]
        },
        "dir": {
          "description": "The project root, relative to the repository root; `.` for the root itself.",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/RunStatus"
        }
      },
      "required": [
        "detail",
        "dir",
        "status"
      ]
    },
    "RunStatus": {
      "description": "Whether a tool's run in a root completed.",
      "oneOf": [
        {
          "description": "It ran to the end, whatever it found.",
          "type": "string",
          "const": "ran"
        },
        {
          "description": "It could not run to the end: a build failure, a crash of the tool, output it cannot read.",
          "type": "string",
          "const": "failed"
        }
      ]
    },
    "SimulationFailure": {
      "description": "The first failure of a harness, and how to see it again.",
      "type": "object",
      "properties": {
        "location": {
          "description": "Where it failed in the repository, when the failure names a place there.",
          "anyOf": [
            {
              "$ref": "#/$defs/Location"
            },
            {
              "type": "null"
            }
          ]
        },
        "message": {
          "description": "What the harness reported: a panic's or an assertion's first line.",
          "type": "string"
        },
        "reproduce": {
          "description": "The command that runs that seed alone, from the project root.",
          "type": "string"
        },
        "reproduced": {
          "description": "Whether replaying the seed alone failed again; a failure that does not repeat is a\nharness that is not deterministic.",
          "type": "boolean"
        },
        "seed": {
          "description": "The failing seed, when the simulator names it.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "trace": {
          "description": "What the harness printed for that seed, replayed alone, with thread numbers and paths\noutside the repository masked; at most 50 lines, the last ones.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "location",
        "message",
        "reproduce",
        "reproduced",
        "seed",
        "trace"
      ]
    },
    "SimulationHarness": {
      "description": "One simulation harness and how its seeds ended.",
      "type": "object",
      "properties": {
        "failure": {
          "description": "What failed, for a failed harness.",
          "anyOf": [
            {
              "$ref": "#/$defs/SimulationFailure"
            },
            {
              "type": "null"
            }
          ]
        },
        "location": {
          "description": "Where it is defined, when known.",
          "anyOf": [
            {
              "$ref": "#/$defs/Location"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "description": "The harness as the test runner names it.",
          "type": "string"
        },
        "root": {
          "description": "The project root it belongs to, as in `runs`.",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/SimulationStatus"
        }
      },
      "required": [
        "failure",
        "location",
        "name",
        "root",
        "status"
      ]
    },
    "SimulationStatus": {
      "description": "How a harness's seeds ended.",
      "oneOf": [
        {
          "description": "Every seed of the range passed.",
          "type": "string",
          "const": "passed"
        },
        {
          "description": "A seed failed, or the harness failed outside any one seed.",
          "type": "string",
          "const": "failed"
        }
      ]
    }
  }
}
