---
source: crates/cupel-core/tests/schemas.rs
expression: pretty(&schema)
---
{
  "$id": "https://tysont.github.io/cupel/schema/v1/finding.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Finding",
  "description": "One actionable observation produced by a check.",
  "type": "object",
  "properties": {
    "action": {
      "$ref": "#/$defs/Action"
    },
    "check": {
      "$ref": "#/$defs/CheckId"
    },
    "confidence": {
      "description": "How sure the check is, from 0 to 1.",
      "type": "number",
      "format": "double",
      "maximum": 1.0,
      "minimum": 0.0
    },
    "detail": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence": {
      "$ref": "#/$defs/Evidence"
    },
    "id": {
      "$ref": "#/$defs/FindingId"
    },
    "kind": {
      "description": "Namespaced finding kind, such as `mutant.survived`.",
      "type": "string"
    },
    "location": {
      "anyOf": [
        {
          "$ref": "#/$defs/Location"
        },
        {
          "type": "null"
        }
      ]
    },
    "new_since_baseline": {
      "type": "boolean"
    },
    "repro": {
      "description": "A command that reproduces this finding.",
      "type": "string"
    },
    "severity": {
      "$ref": "#/$defs/Severity"
    },
    "suppress": {
      "description": "A command that suppresses this finding.",
      "type": "string"
    },
    "suppressed": {
      "type": "boolean"
    },
    "symbol": {
      "anyOf": [
        {
          "$ref": "#/$defs/Symbol"
        },
        {
          "type": "null"
        }
      ]
    },
    "tier": {
      "$ref": "#/$defs/Tier"
    },
    "title": {
      "type": "string"
    }
  },
  "required": [
    "action",
    "check",
    "confidence",
    "detail",
    "evidence",
    "id",
    "kind",
    "location",
    "new_since_baseline",
    "repro",
    "severity",
    "suppress",
    "suppressed",
    "symbol",
    "tier",
    "title"
  ],
  "$defs": {
    "Action": {
      "description": "The concrete next step a finding asks for.",
      "type": "object",
      "properties": {
        "hints": {
          "description": "Kind-specific pointers, such as `nearest_test_file` or `covering_tests`.",
          "type": "object",
          "additionalProperties": true
        },
        "kind": {
          "$ref": "#/$defs/ActionKind"
        },
        "priority": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "summary": {
          "type": "string"
        }
      },
      "required": [
        "hints",
        "kind",
        "priority",
        "summary"
      ]
    },
    "ActionKind": {
      "description": "The closed set of things a finding can ask an agent to do (design §7.2).",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "write_test",
            "strengthen_assertion",
            "restore_test",
            "refactor_extract",
            "reduce_complexity",
            "break_cycle",
            "fix_bug",
            "add_contract",
            "add_property",
            "investigate_flake",
            "rerun",
            "configure",
            "install_tool",
            "verify_oracle"
          ]
        },
        {
          "description": "Last resort when no mechanical action exists.",
          "type": "string",
          "const": "review"
        }
      ]
    },
    "CheckId": {
      "description": "A check's stable namespaced ID, such as `tests.mutation`.",
      "type": "string"
    },
    "Evidence": {
      "description": "Check-specific supporting data. Its shape per finding kind is the JSON Schema the emitting\ncheck declares in its manifest (ADR-012).",
      "type": "object",
      "additionalProperties": true
    },
    "FindingId": {
      "description": "`fnd_` followed by six lowercase hex digits",
      "type": "string",
      "pattern": "^fnd_[0-9a-f]{6}$"
    },
    "LangId": {
      "description": "A language's ID, such as `rust` or `typescript`. Languages are registered by\n`cupel-lang`; core never enumerates them (ADR-011).",
      "type": "string"
    },
    "Location": {
      "description": "A span in a file. Paths are relative to the repository root; lines and columns are 1-based.",
      "type": "object",
      "properties": {
        "col": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "end_col": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "end_line": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "file": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "col",
        "end_col",
        "end_line",
        "file",
        "line"
      ]
    },
    "Severity": {
      "type": "string",
      "enum": [
        "fail",
        "warn",
        "info"
      ]
    },
    "Symbol": {
      "description": "The function or method a finding is about.",
      "type": "object",
      "properties": {
        "display": {
          "description": "`namespace::name`, for people.",
          "type": "string"
        },
        "hash": {
          "description": "Structural identity, for machines.",
          "$ref": "#/$defs/SymbolHash"
        },
        "lang": {
          "$ref": "#/$defs/LangId"
        }
      },
      "required": [
        "display",
        "hash",
        "lang"
      ]
    },
    "SymbolHash": {
      "description": "`sh_` followed by sixteen lowercase hex digits",
      "type": "string",
      "pattern": "^sh_[0-9a-f]{16}$"
    },
    "Tier": {
      "description": "Evidence tier: 0 structural metric … 6 proof.",
      "type": "integer",
      "maximum": 6,
      "minimum": 0
    }
  }
}
