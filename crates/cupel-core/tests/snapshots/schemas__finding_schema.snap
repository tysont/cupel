---
source: crates/cupel-core/tests/schemas.rs
expression: pretty(&schema)
---
{
  "$id": "https://tysont.github.io/cupel/schema/v1/finding.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Finding",
  "description": "One actionable observation produced by a check.",
  "type": "object",
  "properties": {
    "action": {
      "$ref": "#/$defs/Action"
    },
    "check": {
      "$ref": "#/$defs/CheckId"
    },
    "confidence": {
      "description": "How sure the check is, from 0 to 1.",
      "type": "number",
      "format": "double",
      "maximum": 1.0,
      "minimum": 0.0
    },
    "detail": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence": {
      "$ref": "#/$defs/Evidence"
    },
    "id": {
      "$ref": "#/$defs/FindingId"
    },
    "kind": {
      "description": "Namespaced finding kind, such as `mutant.survived`.",
      "type": "string"
    },
    "location": {
      "anyOf": [
        {
          "$ref": "#/$defs/Location"
        },
        {
          "type": "null"
        }
      ]
    },
    "new_since_baseline": {
      "type": "boolean"
    },
    "repro": {
      "description": "A command that reproduces this finding.",
      "type": "string"
    },
    "severity": {
      "$ref": "#/$defs/Severity"
    },
    "suppress": {
      "description": "A command that suppresses this finding.",
      "type": "string"
    },
    "suppressed": {
      "type": "boolean"
    },
    "symbol": {
      "anyOf": [
        {
          "$ref": "#/$defs/Symbol"
        },
        {
          "type": "null"
        }
      ]
    },
    "tier": {
      "$ref": "#/$defs/Tier"
    },
    "title": {
      "type": "string"
    }
  },
  "required": [
    "action",
    "check",
    "confidence",
    "detail",
    "evidence",
    "id",
    "kind",
    "location",
    "new_since_baseline",
    "repro",
    "severity",
    "suppress",
    "suppressed",
    "symbol",
    "tier",
    "title"
  ],
  "$defs": {
    "Action": {
      "description": "The concrete next step a finding asks for.",
      "type": "object",
      "properties": {
        "hints": {
          "description": "Kind-specific pointers, such as `nearest_test_file` or `covering_tests`, and the\nremediation hints of `crate::hint` (ADR-133).",
          "type": "object",
          "properties": {
            "cheapest_cut": {
              "$ref": "#/$defs/CheapestCut",
              "x-cupel-optional": true
            },
            "common_subtree": {
              "$ref": "#/$defs/CommonSubtree",
              "x-cupel-optional": true
            },
            "covering_tests": {
              "description": "Tests that cover the finding's site.",
              "type": "array",
              "items": {
                "type": "string"
              },
              "x-cupel-optional": true
            },
            "deepest_block": {
              "$ref": "#/$defs/DeepestBlock",
              "x-cupel-optional": true
            },
            "nearest_test_file": {
              "description": "The test file nearest to the finding's site.",
              "type": "string",
              "x-cupel-optional": true
            }
          },
          "additionalProperties": true,
          "required": []
        },
        "kind": {
          "$ref": "#/$defs/ActionKind"
        },
        "priority": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "summary": {
          "type": "string"
        }
      },
      "required": [
        "hints",
        "kind",
        "priority",
        "summary"
      ]
    },
    "ActionKind": {
      "description": "The closed set of things a finding can ask an agent to do (design §7.2).",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "write_test",
            "strengthen_assertion",
            "restore_test",
            "refactor_extract",
            "reduce_complexity",
            "break_cycle",
            "fix_bug",
            "add_contract",
            "add_property",
            "investigate_flake",
            "rerun",
            "configure",
            "install_tool",
            "verify_oracle"
          ]
        },
        {
          "description": "Last resort when no mechanical action exists.",
          "type": "string",
          "const": "review"
        }
      ]
    },
    "CheapestCut": {
      "description": "The import to remove to break an import cycle, on `dep.cycle`.",
      "type": "object",
      "properties": {
        "breaks_component": {
          "description": "Whether removing every import from `from` to `to` leaves the cycle's modules with no\ncycle at all.",
          "type": "boolean"
        },
        "from": {
          "description": "The importing module.",
          "type": "string"
        },
        "line": {
          "description": "The line of the first import statement.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "names": {
          "description": "The names the statements import, sorted: what to move.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "specifiers": {
          "description": "The import statements' specifiers, as written.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "to": {
          "description": "The imported module.",
          "type": "string"
        },
        "unnamed": {
          "description": "Statements that import the module whole or name nothing.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "breaks_component",
        "from",
        "line",
        "names",
        "specifiers",
        "to",
        "unnamed"
      ]
    },
    "CheckId": {
      "description": "A check's stable namespaced ID, such as `tests.mutation`.",
      "type": "string"
    },
    "CommonSubtree": {
      "description": "The largest normalized subtree every member of a clone cluster shares: the extraction\ncandidate, on `clone.cluster`.",
      "type": "object",
      "properties": {
        "location": {
          "description": "Where it is in the finding's symbol, the cluster's first member.",
          "$ref": "#/$defs/Location"
        },
        "nodes": {
          "description": "Nodes of the shared normalized subtree.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "others": {
          "description": "Where it is in each other member, in the evidence's member order.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/PlacedSubtree"
          }
        },
        "parameters": {
          "description": "The identifiers and literals whose text differs between members: what the extracted\nfunction takes as parameters.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Parameter"
          }
        },
        "share": {
          "description": "Its share of the first member's normalized nodes, to three decimals.",
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "location",
        "nodes",
        "others",
        "parameters",
        "share"
      ]
    },
    "DecisionKind": {
      "type": "string",
      "enum": [
        "branch",
        "loop",
        "boolean-op",
        "case",
        "catch",
        "early-return",
        "ternary"
      ]
    },
    "DeepestBlock": {
      "description": "The function's most deeply nested block: the extraction candidate, on `complexity.high`.",
      "type": "object",
      "properties": {
        "cognitive": {
          "description": "What they add to its cognitive complexity, nesting increments included.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "cyclomatic": {
          "description": "What the decisions inside the block add to the function's cyclomatic complexity.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "location": {
          "$ref": "#/$defs/Location"
        },
        "nesting": {
          "description": "Enclosing blocks that nest it, 0 at the top of the body.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "path": {
          "description": "The construct kinds from the outermost enclosing block to this block.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/DecisionKind"
          }
        }
      },
      "required": [
        "cognitive",
        "cyclomatic",
        "location",
        "nesting",
        "path"
      ]
    },
    "Evidence": {
      "description": "Check-specific supporting data. Its shape per finding kind is the JSON Schema the emitting\ncheck declares in its manifest (ADR-012).",
      "type": "object",
      "additionalProperties": true
    },
    "FindingId": {
      "description": "`fnd_` followed by six lowercase hex digits",
      "type": "string",
      "pattern": "^fnd_[0-9a-f]{6}$"
    },
    "LangId": {
      "description": "A language's ID, such as `rust` or `typescript`. Languages are registered by\n`cupel-lang`; core never enumerates them (ADR-011).",
      "type": "string"
    },
    "Location": {
      "description": "A span in a file. Paths are relative to the repository root; lines and columns are 1-based.",
      "type": "object",
      "properties": {
        "col": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "end_col": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "end_line": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "file": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "col",
        "end_col",
        "end_line",
        "file",
        "line"
      ]
    },
    "Parameter": {
      "description": "One position of the shared subtree whose text differs between members.",
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/ParameterKind"
        },
        "occurrences": {
          "description": "How many positions in the subtree have these values.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "values": {
          "description": "The text in each member, the first member's first.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "kind",
        "occurrences",
        "values"
      ]
    },
    "ParameterKind": {
      "description": "What a differing position is.",
      "type": "string",
      "enum": [
        "identifier",
        "literal"
      ]
    },
    "PlacedSubtree": {
      "description": "The shared subtree in one member of a clone cluster.",
      "type": "object",
      "properties": {
        "location": {
          "$ref": "#/$defs/Location"
        },
        "symbol": {
          "description": "The member's display name.",
          "type": "string"
        }
      },
      "required": [
        "location",
        "symbol"
      ]
    },
    "Severity": {
      "type": "string",
      "enum": [
        "fail",
        "warn",
        "info"
      ]
    },
    "Symbol": {
      "description": "The function or method a finding is about.",
      "type": "object",
      "properties": {
        "display": {
          "description": "`namespace::name`, for people.",
          "type": "string"
        },
        "hash": {
          "description": "Structural identity, for machines.",
          "$ref": "#/$defs/SymbolHash"
        },
        "lang": {
          "$ref": "#/$defs/LangId"
        }
      },
      "required": [
        "display",
        "hash",
        "lang"
      ]
    },
    "SymbolHash": {
      "description": "`sh_` followed by sixteen lowercase hex digits",
      "type": "string",
      "pattern": "^sh_[0-9a-f]{16}$"
    },
    "Tier": {
      "description": "Evidence tier: 0 structural metric … 6 proof.",
      "type": "integer",
      "maximum": 6,
      "minimum": 0
    }
  }
}
