---
source: crates/cupel-core/tests/schemas.rs
expression: pretty(&schema)
---
{
  "$id": "https://tysont.github.io/cupel/schema/v1/fact/test-frames.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TestFrames",
  "description": "Test cases and what they assert, mock, skip, and set up.",
  "type": "object",
  "properties": {
    "files": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/TestFile"
      }
    }
  },
  "required": [
    "files"
  ],
  "x-cupel-fact-version": 4,
  "$defs": {
    "Assertion": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/AssertionKind"
        },
        "precision": {
          "description": "How much of the expected value a strong assertion pins (ADR-237).",
          "$ref": "#/$defs/Precision"
        },
        "span": {
          "$ref": "#/$defs/Span"
        },
        "strength": {
          "$ref": "#/$defs/AssertionStrength"
        }
      },
      "required": [
        "kind",
        "precision",
        "span",
        "strength"
      ]
    },
    "AssertionKind": {
      "type": "string",
      "enum": [
        "equality",
        "truthiness",
        "not-null",
        "throws",
        "snapshot",
        "custom"
      ]
    },
    "AssertionStrength": {
      "type": "string",
      "enum": [
        "strong",
        "weak"
      ]
    },
    "Mock": {
      "type": "object",
      "properties": {
        "span": {
          "$ref": "#/$defs/Span"
        },
        "target": {
          "description": "What is replaced, as written.",
          "type": "string"
        }
      },
      "required": [
        "span",
        "target"
      ]
    },
    "Precision": {
      "description": "How much of the expected value an assertion pins, apart from its strength: `tests.weakening`\nreads a change from `exact` to any other as a loosened matcher (ADR-237).",
      "oneOf": [
        {
          "description": "One value: equality, an exception's type, a snapshot.",
          "type": "string",
          "const": "exact"
        },
        {
          "description": "Any element of a collection: `assert a in b`, `toContain`, `Contains`, `isIn`.",
          "type": "string",
          "const": "membership"
        },
        {
          "description": "Part of the value: a substring, prefix, pattern, or subset of properties.",
          "type": "string",
          "const": "partial"
        },
        {
          "description": "A value within a tolerance: `pytest.approx`, `toBeCloseTo`, `InDelta`.",
          "type": "string",
          "const": "approximate"
        },
        {
          "description": "Any value of a type: `expect.any(Number)`, `IsType`, `isInstanceOf`.",
          "type": "string",
          "const": "type"
        },
        {
          "description": "Any value at all: `mock.ANY`, `expect.anything()`.",
          "type": "string",
          "const": "any"
        }
      ]
    },
    "SkipMarker": {
      "type": "object",
      "properties": {
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "span": {
          "$ref": "#/$defs/Span"
        }
      },
      "required": [
        "reason",
        "span"
      ]
    },
    "Span": {
      "description": "A 1-based range within one file.",
      "type": "object",
      "properties": {
        "col": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "end_col": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "end_line": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "line": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "col",
        "end_col",
        "end_line",
        "line"
      ]
    },
    "TestCase": {
      "type": "object",
      "properties": {
        "assertions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Assertion"
          }
        },
        "doc": {
          "description": "The case's doc comment or docstring as written, comment markers and quotes included;\n`None` without one (ADR-134).",
          "type": [
            "string",
            "null"
          ]
        },
        "mocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Mock"
          }
        },
        "name": {
          "type": "string"
        },
        "property": {
          "description": "The property-based framework that generates the case's inputs, such as `proptest` or\n`hypothesis`; `None` for a case with fixed inputs (ADR-095).",
          "type": [
            "string",
            "null"
          ]
        },
        "skip": {
          "anyOf": [
            {
              "$ref": "#/$defs/SkipMarker"
            },
            {
              "type": "null"
            }
          ]
        },
        "span": {
          "$ref": "#/$defs/Span"
        }
      },
      "required": [
        "assertions",
        "doc",
        "mocks",
        "name",
        "property",
        "skip",
        "span"
      ]
    },
    "TestFile": {
      "type": "object",
      "properties": {
        "cases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TestCase"
          }
        },
        "file": {
          "type": "string"
        },
        "framework": {
          "description": "The test framework, such as `pytest` or `vitest`.",
          "type": "string"
        },
        "mocks": {
          "description": "Test doubles created outside every case (a module-level `vi.mock`, a class-level `@Mock`\nfield): installed for the whole file, and no one case's (ADR-164).",
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/Mock"
          }
        },
        "setup": {
          "description": "Setup and fixture blocks shared by the file's cases.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Span"
          }
        }
      },
      "required": [
        "cases",
        "file",
        "framework",
        "mocks",
        "setup"
      ]
    }
  }
}
