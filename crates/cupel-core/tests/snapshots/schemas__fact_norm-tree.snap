---
source: crates/cupel-core/tests/schemas.rs
expression: pretty(&schema)
---
{
  "$id": "https://tysont.github.io/cupel/schema/v1/fact/norm-tree.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NormTree",
  "description": "Normalized syntax trees per symbol, and the structural hash each yields.",
  "type": "object",
  "properties": {
    "symbols": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/NormalizedSymbol"
      }
    }
  },
  "required": [
    "symbols"
  ],
  "x-cupel-fact-version": 1,
  "$defs": {
    "NormNode": {
      "description": "A node of a normalized tree. Labels are language-independent so trees in one family compare.\nIts shape is its label and its children's shapes; the span and text say where it came from\nand are not part of the shape (ADR-133).",
      "type": "object",
      "properties": {
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NormNode"
          }
        },
        "label": {
          "type": "string"
        },
        "span": {
          "description": "Where the syntax node this node was normalized from is in the file; absent when the\nproducer does not say.",
          "anyOf": [
            {
              "$ref": "#/$defs/Span"
            },
            {
              "type": "null"
            }
          ],
          "x-cupel-optional": true
        },
        "text": {
          "description": "The source text of an identifier or literal that normalized to a marker (`$id`, `$lit`);\nabsent for every other node.",
          "type": [
            "string",
            "null"
          ],
          "x-cupel-optional": true
        }
      },
      "required": [
        "children",
        "label"
      ]
    },
    "NormalizedSymbol": {
      "type": "object",
      "properties": {
        "hash": {
          "$ref": "#/$defs/SymbolHash"
        },
        "root": {
          "$ref": "#/$defs/NormNode"
        },
        "symbol": {
          "$ref": "#/$defs/SymbolKey"
        }
      },
      "required": [
        "hash",
        "root",
        "symbol"
      ]
    },
    "Span": {
      "description": "A 1-based range within one file.",
      "type": "object",
      "properties": {
        "col": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "end_col": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "end_line": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "line": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "col",
        "end_col",
        "end_line",
        "line"
      ]
    },
    "SymbolHash": {
      "description": "`sh_` followed by sixteen lowercase hex digits",
      "type": "string",
      "pattern": "^sh_[0-9a-f]{16}$"
    },
    "SymbolKey": {
      "description": "Identifies a symbol within one run by where it starts. Not stable across edits; anything\npersisted across runs uses `SymbolHash` (ADR-014).",
      "type": "object",
      "properties": {
        "col": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "file": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "col",
        "file",
        "line"
      ]
    }
  }
}
