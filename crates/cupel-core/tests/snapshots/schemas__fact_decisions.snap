---
source: crates/cupel-core/tests/schemas.rs
expression: pretty(&schema)
---
{
  "$id": "https://cupel.dev/schema/v1/fact/decisions.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Decisions",
  "description": "Decision points per symbol, with the weights the language's tables assign.",
  "type": "object",
  "properties": {
    "symbols": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SymbolDecisions"
      }
    }
  },
  "required": [
    "symbols"
  ],
  "x-cupel-fact-version": 2,
  "$defs": {
    "Decision": {
      "type": "object",
      "properties": {
        "cognitive": {
          "description": "Base weight toward cognitive complexity, before nesting.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "continues": {
          "description": "A `case` arm after the first of its match or switch: the same multiway decision, which\nmodified cyclomatic complexity counts once (ADR-072). Always false for other kinds.",
          "type": "boolean"
        },
        "cyclomatic": {
          "description": "Weight toward cyclomatic complexity.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "kind": {
          "$ref": "#/$defs/DecisionKind"
        },
        "nesting": {
          "description": "Depth of enclosing decisions, 0 at the top of the body.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "table": {
          "description": "A loop over a table of cases written in place: a literal array, vector, slice, list, or\ntuple, iterated directly or through a local bound to one in the same body (ADR-069).\nAlways false for other kinds.",
          "type": "boolean"
        }
      },
      "required": [
        "cognitive",
        "continues",
        "cyclomatic",
        "kind",
        "nesting",
        "table"
      ]
    },
    "DecisionKind": {
      "type": "string",
      "enum": [
        "branch",
        "loop",
        "boolean-op",
        "case",
        "catch",
        "early-return",
        "ternary"
      ]
    },
    "SymbolDecisions": {
      "type": "object",
      "properties": {
        "decisions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Decision"
          }
        },
        "symbol": {
          "$ref": "#/$defs/SymbolKey"
        }
      },
      "required": [
        "decisions",
        "symbol"
      ]
    },
    "SymbolKey": {
      "description": "Identifies a symbol within one run by where it starts. Not stable across edits; anything\npersisted across runs uses `SymbolHash` (ADR-014).",
      "type": "object",
      "properties": {
        "col": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "file": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "col",
        "file",
        "line"
      ]
    }
  }
}
